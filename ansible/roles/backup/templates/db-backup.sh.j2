#!/usr/bin/env bash
# Managed by Ansible - do not edit by hand.
#
# Dumps the Postgres database, packs it as a .tar.gz and uploads it to S3.
# AWS access comes from the EC2 instance role (no keys stored on the server).
set -Eeuo pipefail

BUCKET="{{ s3_bucket }}"
REGION="{{ aws_region }}"
CONTAINER="{{ db_container_name }}"
DB_NAME="{{ db_name }}"
DB_USER="{{ db_user }}"
COMPOSE_FILE="{{ backup_compose_file }}"
BACKUP_DIR="{{ backup_dir }}"
KEEP_DAYS="{{ backup_local_keep_days }}"

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
name="db-backup-${timestamp}"

log() { echo "[$(date -u +%FT%TZ)] $*"; }

# Never run two backups at the same time.
exec 9>/var/lock/db-backup.lock
flock -n 9 || { log "another backup is already running - exiting"; exit 1; }

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

log "dumping database '${DB_NAME}' from container '${CONTAINER}'"
docker exec "$CONTAINER" pg_dump -U "$DB_USER" -d "$DB_NAME" --no-owner > "${work}/${name}.sql"
cp "$COMPOSE_FILE" "${work}/docker-compose.yml"

archive="${BACKUP_DIR}/${name}.tar.gz"
tar -czf "$archive" -C "$work" .
log "created ${archive} ($(du -h "$archive" | cut -f1))"

log "uploading to s3://${BUCKET}/backups/${name}.tar.gz"
aws s3 cp "$archive" "s3://${BUCKET}/backups/${name}.tar.gz" --region "$REGION" --only-show-errors

# Keep only the last KEEP_DAYS days of local copies (S3 has its own lifecycle rule).
find "$BACKUP_DIR" -name 'db-backup-*.tar.gz' -mtime +"$KEEP_DAYS" -delete

log "backup finished OK"
