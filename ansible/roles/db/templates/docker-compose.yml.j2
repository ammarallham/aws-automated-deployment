# Managed by Ansible - do not edit by hand.
services:
  postgres:
    image: {{ db_postgres_image }}
    container_name: {{ db_container_name }}
    restart: unless-stopped
    env_file: .env
    ports:
      # Listen only on the private VPC address, never on the public one.
      - "{{ ansible_default_ipv4.address }}:{{ db_port }}:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 12
      start_period: 10s

volumes:
  pgdata:
